{
  "manifestVersion": 2,
  "id": "nord-midnight-theme",
  "name": "Nord Midnight",
  "version": "1.2.0",
  "description": "Nord with a deeper, uniform #1C1E21 dark background, plus a matching Nord Light variant.",
  "author": {
    "name": "Marco Calderon",
    "url": "https://github.com/marco-calderon"
  },
  "license": "MIT",
  "repository": "https://github.com/marco-calderon/nord-midnight-orca-theme",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "data",
  "contributes": {
    "themes": [
      {
        "id": "nord-midnight",
        "title": "Nord Midnight",
        "path": "themes/dark.json"
      },
      {
        "id": "nord-midnight-light",
        "title": "Nord Midnight Light",
        "path": "themes/light.json"
      }
    ]
  }
}
